__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
CLAUDE.local.md
.claude/

# macOS
.DS_Store

# Diagnostic dumps
_slsqp_diagnostic_*.npz

# Generated outputs (benchmark results, images). ``outputs`` may be a
# symlink to an external store (e.g. ~/Documents/ResearchOutputs/toyomacro),
# so match it with and without a trailing slash.
output/
outputs
outputs/

# User-specific MCP config (contains absolute paths)
.mcp.json

# JS tooling, should any be introduced
node_modules/

# Superseded internal notes kept beside the code they describe
# (docs/_archived, voigtfit/_archived). Matches at any depth.
_archived/

# Personal analysis / paper-figure scripts — kept out of the public
# repo pending case-by-case review of what is shareable.
scripts/

# Internal-only documents (proposal drafts, business notes). Never
# pushed to the public repo.
_internal/

# Internal planning documents (factory/operations context). Never
# pushed to the public repo.
IMPLEMENTATION_PLAN.md

# Uncertainty-quantification backbone audit. References private deppro
# internals; held for a dedicated public release alongside the
# xps-uncertainty work rather than shipping with the current engine.
docs/uncertainty_backbone_audit.md

# Local working notes and handoffs. The GUI, web front end and depth
# pipeline that used to live here moved out on 2026-07-28 (see README);
# their ignore entries went with them.
CLAUDE.md
docs/HANDOFF_FULL_SURVEY_CRLB.md
docs/HANDOFF_EAL_ELASTIC_SCATTERING.md
docs/SESSION_GVRT_RESOLUTION_SCALING.md

